{
  "manifest_version": 3,
  "name": "教典鬥搜揣",
  "version": "0.1.0",
  "description": "為教育部臺灣台語常用詞辭典加上模糊、正規表示式與多音標系統（台羅/白話字/方音符號/注音相似音）即時搜尋建議",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://sutian.moe.edu.tw/*"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/kautian.min.json"],
      "matches": ["https://sutian.moe.edu.tw/*"]
    }
  ]
}
